# ==========================================
# BranchWiki / CodeHunters Root .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js Build Outputs
.next/
*/.next/
out/
*/out/
build/
*/build/
dist/
*/dist/

# Backend Git Repositories
# Note: Isomorphic-git creates repos with nested .git folders dynamically at runtime.
# Ignoring runtime wiki directories prevents nested git submodule collisions.
backend/repositories/*
!backend/repositories/.gitkeep
repositories/*
!repositories/.gitkeep

# Environment variables & secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Next.js cache & telemetry
.turbo/
*.tsbuildinfo

# OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Testing & Coverage
coverage/
.nyc_output/
*.lcov
